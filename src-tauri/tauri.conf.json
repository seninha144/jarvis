{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J.A.R.V.I.S.",
  "version": "0.1.0",
  "identifier": "com.jarvis.personal-intelligence",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "J.A.R.V.I.S.",
      "width": 1440,
      "height": 900,
      "minWidth": 760,
      "minHeight": 620,
      "resizable": true,
      "center": true,
      "decorations": true,
      "backgroundColor": "#04080A"
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["local/**/*"]
  }
}
