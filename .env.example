AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

STT_PROVIDER=local
TTS_PROVIDER=local
WHISPER_MODEL=ggml-base.bin
PIPER_VOICE=pt_BR-cadu-medium.onnx
